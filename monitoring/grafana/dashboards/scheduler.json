{
  "annotations": { "list": [] },
  "title": "UTOS Scheduler",
  "uid": "utos-scheduler",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["utos", "scheduler"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "Active Workers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "utos_workers_active", "legendFormat": "workers" }],
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 }
    },
    {
      "title": "Retry Queue Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "utos_retry_queue_size", "legendFormat": "retry queue" }],
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 }
    },
    {
      "title": "DLQ Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "utos_dlq_size", "legendFormat": "DLQ" }],
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 }
    },
    {
      "title": "Workers Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "utos_workers_active", "legendFormat": "active workers" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "title": "Queue Sizes Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "utos_retry_queue_size", "legendFormat": "retry" }, { "expr": "utos_dlq_size", "legendFormat": "DLQ" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    }
  ]
}
