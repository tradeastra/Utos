{
  "annotations": { "list": [] },
  "title": "UTOS System Overview",
  "uid": "utos-system",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["utos", "system"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "Requests/sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(rate(utos_http_requests_total[1m]))", "legendFormat": "req/s" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "title": "P95 Latency (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(utos_http_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "p95" }],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(rate(utos_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(utos_http_requests_total[5m]))", "legendFormat": "error rate" }],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "title": "Active Trading Instances",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(utos_trading_instances_active)", "legendFormat": "instances" }],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100", "legendFormat": "CPU %" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "connections" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "title": "Redis Info",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "redis_connected_clients", "legendFormat": "clients" }, { "expr": "redis_used_memory", "legendFormat": "memory" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    },
    {
      "title": "Disk Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}", "legendFormat": "available" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 }
    }
  ]
}
