{
  "annotations": { "list": [] },
  "title": "UTOS Recovery",
  "uid": "utos-recovery",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["utos", "recovery"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Recovery Count",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(utos_recovery_total)", "legendFormat": "total" }],
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 }
    },
    {
      "title": "Failed Recoveries",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(utos_recovery_total{result=\"failed\"})", "legendFormat": "failed" }],
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 }
    },
    {
      "title": "Recovery Duration P95 (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(utos_recovery_duration_ms_bucket[5m])) by (le))", "legendFormat": "p95" }],
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 }
    },
    {
      "title": "Recovery by Layer",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "sum(rate(utos_recovery_total[5m])) by (layer)", "legendFormat": "{{layer}}" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 }
    },
    {
      "title": "Recovery Duration by Layer",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(utos_recovery_duration_ms_bucket[5m])) by (le, layer))", "legendFormat": "{{layer}} p95" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
    }
  ]
}
