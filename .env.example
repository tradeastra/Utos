# ─────────────────────────────────────────
#  UTOS Trading Engine — Environment Variables
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────

# Application
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security — CHANGE THIS before any deployment
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=utos
POSTGRES_PASSWORD=utos_dev_password
POSTGRES_DB=utos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://utos:utos_dev_password@localhost:5432/utos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Test Database
TEST_DATABASE_URL=postgresql+asyncpg://utos:utos_dev_password@localhost:5432/utos_test

# Redis
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Testing flag
TESTING=false

# ── Production (Sprint 16A) ──────────────────
# Docker Compose ports
HTTP_PORT=80
HTTPS_PORT=443

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
