# ─────────────────────────────────────────────
# Sprint 16E-8: Production Environment Variables
# ─────────────────────────────────────────────

# Application
APP_ENV=production
DEBUG=false

# Security — MUST be set before deployment
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_PRODUCTION_SECRET_KEY_MIN_32_CHARS
ENCRYPTION_KEY=REPLACE_WITH_PRODUCTION_ENCRYPTION_KEY

# Database
POSTGRES_USER=utos
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD
POSTGRES_DB=utos

# CORS
CORS_ORIGINS=https://utos.yourdomain.com

# Ports
HTTP_PORT=80
HTTPS_PORT=443

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Docker images
IMAGE_PREFIX=andra2112s/utos
IMAGE_TAG=latest

# Backup
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_COUNT=10

# Rollback monitor
ROLLBACK_CHECK_INTERVAL=10
ROLLBACK_FAILURE_THRESHOLD=3
ROLLBACK_LATENCY_THRESHOLD=2000
ROLLBACK_ERROR_RATE=0.05
