# ─────────────────────────────────────────────
# Sprint 16E-8: Staging Environment Variables
# ─────────────────────────────────────────────

# Application
APP_ENV=staging
DEBUG=false

# Security — generate with: openssl rand -hex 32
STAGING_SECRET_KEY=replace-with-staging-secret-key-at-least-32-chars
SECRET_KEY=replace-with-staging-secret-key-at-least-32-chars

# Database
POSTGRES_USER=utos
POSTGRES_PASSWORD=utos_staging_password
POSTGRES_DB=utos_staging

# CORS
STAGING_CORS_ORIGINS=https://staging.utos.local
CORS_ORIGINS=https://staging.utos.local

# Ports
HTTP_PORT=8080
HTTPS_PORT=8443

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Docker images
IMAGE_PREFIX=andra2112s/utos
IMAGE_TAG=staging

# Backup
BACKUP_RETENTION_DAYS=3
BACKUP_RETENTION_COUNT=5
